# Yerel menu/GUI isteklerinde kullanilan en az 32 karakterlik gizli anahtar.
INGEST_TOKEN=buraya-en-az-32-karakter-rastgele-bir-anahtar

# Discord Developer Portal > Bot sayfasindaki token. Asla Roblox/Luau koduna koymayin.
DISCORD_BOT_TOKEN=

# Developer Mode acikken hedef kanala sag tik > Copy Channel ID.
DISCORD_CHANNEL_ID=

PORT=8787
PUBLISH_DEBOUNCE_MS=750

# Bu sure boyunca snapshot/heartbeat gelmezse MM2 baglantisi kesildi karti gosterilir.
CONNECTION_TIMEOUT_MS=15000

# Son heartbeat'ten sonra gercek Node bot surecini kapatir. CONNECTION_TIMEOUT_MS'den buyuk olmalidir.
AUTO_SHUTDOWN_MS=30000
